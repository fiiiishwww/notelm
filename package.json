{
  "name": "study-notebook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "学习型笔记软件：三栏（目录 / 文章 / 批注）+ 本地 Markdown 存储 + AI 增强",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore \"./notes/**\" --ignore \"./dist/**\" --ignore \"./.local/**\" server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --prod",
    "mcp": "tsx server/mcp.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "katex": "^0.19.0",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
